{
  "name": "sam-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SAM front ends (Equipment Profile, Werkstatt) and their shared parts, built with the Syn design system.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sam/equipment-profile",
    "dev:profile": "npm run dev -w @sam/equipment-profile",
    "dev:werkstatt": "npm run dev -w @sam/werkstatt",
    "build": "npm run build --workspaces --if-present",
    "build:single": "npm run build:single --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-singlefile": "2.0.3"
  }
}
